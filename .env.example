# Public values only. Next.js inlines NEXT_PUBLIC_ variables into the browser bundle.
# Never put a private key, seed phrase, or API secret in this file.

# Base RPC used for reads and transaction receipts (defaults to https://mainnet.base.org).
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Optional. Set to show the "GitHub repository" button in the Open source section.
# NEXT_PUBLIC_REPO_URL=https://github.com/<owner>/<repo>
